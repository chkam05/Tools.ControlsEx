<Page
    x:Class="chkam05.Tools.ControlsEx.Example.Pages.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:cex="clr-namespace:chkam05.Tools.ControlsEx;assembly=chkam05.Tools.ControlsEx"
    xmlns:cexThm="clr-namespace:chkam05.Tools.ControlsEx.Data.Theme;assembly=chkam05.Tools.ControlsEx"
    xmlns:local="clr-namespace:chkam05.Tools.ControlsEx.Example.Pages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:chkam05.Tools.ControlsEx.Example.Views"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800"
    Title="Informations">

    <Page.Resources>
        <x:Static x:Key="ThemeMgr" Member="cexThm:ThemeManager.Instance"/>
    </Page.Resources>

    <Page.Background>
        <Binding Path="DataContext.ThemeBackground" Mode="OneWay" Source="{StaticResource ThemeMgr}"/>
    </Page.Background>

    <Page.Foreground>
        <Binding Path="DataContext.ThemeForeground" Mode="OneWay" Source="{StaticResource ThemeMgr}"/>
    </Page.Foreground>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            BorderThickness="0"
            Grid.Row="0"
            Padding="8">

            <StackPanel
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Height="28"
                    Kind="InfoOutline"
                    Width="28"
                    VerticalAlignment="Center"/>

                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="8,0,0,0"
                    Text="{Binding Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
                    VerticalAlignment="Center"/>

            </StackPanel>
        </Border>

        <cex:ScrollViewerEx
            Grid.Row="1">

            <StackPanel
                Margin="16,8"
                Orientation="Vertical">

                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Demo Application:"/>

                <views:AssemblyView
                    DataContext="{Binding AppAssemblyInfo}"
                    Margin="0,8,0,16"/>

                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="ControlsEx Library:"/>

                <views:AssemblyView
                    DataContext="{Binding LibAssemblyInfo}"
                    Margin="0,8,0,16"/>

            </StackPanel>

        </cex:ScrollViewerEx>
    </Grid>
</Page>

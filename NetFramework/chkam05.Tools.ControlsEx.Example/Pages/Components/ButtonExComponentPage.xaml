<Page
    x:Class="chkam05.Tools.ControlsEx.Example.Pages.Components.ButtonExComponentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:cex="clr-namespace:chkam05.Tools.ControlsEx;assembly=chkam05.Tools.ControlsEx"
    xmlns:cexThm="clr-namespace:chkam05.Tools.ControlsEx.Data.Theme;assembly=chkam05.Tools.ControlsEx"
    xmlns:local="clr-namespace:chkam05.Tools.ControlsEx.Example.Pages.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d"
    d:DesignWidth="800"
    Style="{DynamicResource GenericPageStyle}"
    Title="ButtonEx">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/chkam05.Tools.ControlsEx.Example;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <x:Static x:Key="ThemeMgr" Member="cexThm:ThemeManager.Instance"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            BorderThickness="0"
            Grid.Row="0"
            Padding="8">

            <StackPanel
                Orientation="Horizontal">

                <materialDesign:PackIcon
                    Height="40"
                    Kind="GestureTapButton"
                    Width="40"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Margin="8,0,0,0"
                    Orientation="Vertical">

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,0,2"
                        Text="{Binding Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="ButtonEx component demo/test"/>

                </StackPanel>

            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="1"
            Orientation="Vertical">

            <TextBlock
                FontWeight="SemiBold"
                FontSize="14"
                Margin="4,8,4,0"
                Text="Preview:"/>

            <Grid
                Margin="8">

                <cex:ButtonEx
                    BorderThickness="{Binding BorderThicknessProperty}"
                    Content="{Binding ContentProperty}"
                    CornerRadius="{Binding CornerRadiusProperty}"
                    IsEnabled="{Binding EnabledProperty}"
                    Height="{Binding HeightProperty, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="{Binding WidthProperty, Mode=OneWay}"/>

            </Grid>
        </StackPanel>

        <Border
            Background="{Binding DataContext.ThemeBackgroundShade, Mode=OneWay, Source={StaticResource ThemeMgr}}"
            BorderBrush="{Binding DataContext.ThemeBackgroundShade, Mode=OneWay, Source={StaticResource ThemeMgr}}"
            BorderThickness="1"
            CornerRadius="4"
            Grid.Row="2"
            Height="4"
            Margin="48,8"/>

        <cex:ScrollViewerEx
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Orientation="Vertical">

                <TextBlock
                    FontWeight="SemiBold"
                    FontSize="14"
                    Margin="4,8,4,2"
                    Text="Background:"/>

                <cex:WideViewButtonEx
                    Description="Background color of the component"
                    IconKind="FormatColorFill"
                    Title="Background"/>

                <cex:WideViewButtonEx
                    Description="Background color when component is inactive (disabled)"
                    IconKind="FormatColorFill"
                    Title="BackgroundInactive"/>

                <cex:WideViewButtonEx
                    Description="Background color when mouse is hovering it"
                    IconKind="FormatColorFill"
                    Title="BackgroundMouseOver"/>

                <cex:WideViewButtonEx
                    Description="Background color when ButtonEx is pressed"
                    IconKind="FormatColorFill"
                    Title="BackgroundPressed"/>

                <TextBlock
                    FontWeight="SemiBold"
                    FontSize="14"
                    Margin="4,8,4,2"
                    Text="Border:"/>

                <cex:WideViewButtonEx
                    Description="Border color of the component"
                    IconKind="BorderColor"
                    Title="BorderBrush"/>

                <cex:WideViewButtonEx
                    Description="Border color when component is inactive (disabled)"
                    IconKind="BorderColor"
                    Title="BorderBrushInactive"/>

                <cex:WideViewButtonEx
                    Description="Border color when mouse is hovering it"
                    IconKind="BorderColor"
                    Title="BorderBrushMouseOver"/>

                <cex:WideViewButtonEx
                    Description="Border color when ButtonEx is pressed"
                    IconKind="BorderColor"
                    Title="BorderBrushPressed"/>

                <TextBlock
                    FontWeight="SemiBold"
                    FontSize="14"
                    Margin="4,8,4,2"
                    Text="Foreground:"/>

                <cex:WideViewButtonEx
                    Description="Foreground (text) color of the component"
                    IconKind="FormatColorText"
                    Title="Foreground"/>

                <cex:WideViewButtonEx
                    Description="Foreground (text) color when component is inactive (disabled)"
                    IconKind="FormatColorText"
                    Title="ForegroundInactive"/>

                <cex:WideViewButtonEx
                    Description="Foreground (text) color when mouse is hovering it"
                    IconKind="FormatColorText"
                    Title="ForegroundMouseOver"/>

                <cex:WideViewButtonEx
                    Description="Foreground (text) color when ButtonEx is pressed"
                    IconKind="FormatColorText"
                    Title="ForegroundPressed"/>

                <TextBlock
                    FontWeight="SemiBold"
                    FontSize="14"
                    Margin="4,8,4,2"
                    Text="General:"/>

                <cex:WideViewButtonEx
                    Description="Thickness of the component"
                    IconKind="BorderOuter"
                    Title="Thickness">

                    <Grid
                        HorizontalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <cex:UpDownDoubleEx
                            Grid.Column="0"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding BorderThicknessLeftProperty, Mode=TwoWay}"/>

                        <cex:UpDownDoubleEx
                            Grid.Column="1"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding BorderThicknessTopProperty, Mode=TwoWay}"/>

                        <cex:UpDownDoubleEx
                            Grid.Column="2"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding BorderThicknessRightProperty, Mode=TwoWay}"/>

                        <cex:UpDownDoubleEx
                            Grid.Column="1"
                            Grid.Row="2"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding BorderThicknessBottomProperty, Mode=TwoWay}"/>

                    </Grid>
                    
                </cex:WideViewButtonEx>

                <cex:WideViewButtonEx
                    Description="Rounding the edges of a component"
                    IconKind="RoundedCorner"
                    Title="CornerRadius">

                    <Grid
                        HorizontalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <cex:UpDownDoubleEx
                            Grid.Column="0"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding CornerRadiusPropertyTopLeftProperty, Mode=TwoWay}"/>

                        <cex:UpDownDoubleEx
                            Grid.Column="1"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding CornerRadiusPropertyTopRightProperty, Mode=TwoWay}"/>

                        <cex:UpDownDoubleEx
                            Grid.Column="1"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding CornerRadiusPropertyBottomRightProperty, Mode=TwoWay}"/>

                        <cex:UpDownDoubleEx
                            Grid.Column="0"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="16"
                            Value="{Binding CornerRadiusPropertyBottomLeftProperty, Mode=TwoWay}"/>

                    </Grid>

                </cex:WideViewButtonEx>

                <cex:WideViewButtonEx
                    Description="Enables or disables the ability to interact with a component"
                    IconKind="ToggleSwitchOutline"
                    Title="Enable">

                    <cex:ToggleEx
                        HorizontalAlignment="Right"
                        IsChecked="{Binding EnabledProperty}"
                        ToggleType="Outline"/>

                </cex:WideViewButtonEx>

                <cex:WideViewButtonEx
                    Description="Component height"
                    IconKind="ArrowUpDown"
                    Title="Height">

                    <cex:UpDownDoubleEx
                        Minimum="0"
                        Maximum="128"
                        Value="{Binding HeightProperty, Mode=TwoWay}"/>

                </cex:WideViewButtonEx>

                <cex:WideViewButtonEx
                    Description="Component width"
                    IconKind="ArrowLeftRight"
                    Title="Width">

                    <cex:UpDownDoubleEx
                        Minimum="0"
                        Maximum="256"
                        Value="{Binding WidthProperty, Mode=TwoWay}"/>

                </cex:WideViewButtonEx>

                <TextBlock
                    FontWeight="SemiBold"
                    FontSize="14"
                    Margin="4,8,4,2"
                    Text="Individual:"/>

                <cex:WideViewButtonEx
                    Description="Component content"
                    IconKind="FormTextbox"
                    Title="Content">

                    <cex:TextBoxEx
                        Height="28"
                        Text="{Binding ContentProperty}"/>

                </cex:WideViewButtonEx>

            </StackPanel>
        </cex:ScrollViewerEx>
    </Grid>
</Page>

<UserControl
    x:Class="chkam05.Tools.ControlsEx.Example.Views.AssemblyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:cexThm="clr-namespace:chkam05.Tools.ControlsEx.Data.Theme;assembly=chkam05.Tools.ControlsEx"
    xmlns:local="clr-namespace:chkam05.Tools.ControlsEx.Example.Views"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <UserControl.Resources>
        <x:Static x:Key="ThemeMgr" Member="cexThm:ThemeManager.Instance"/>

        <Style x:Key="HeaderTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeForeground, Mode=OneWay, Source={StaticResource ThemeMgr}}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{Binding DataContext.ThemeForeground, Mode=OneWay, Source={StaticResource ThemeMgr}}"/>
            <Setter Property="Margin" Value="16,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <UserControl.Background>
        <Binding Path="DataContext.ThemeBackground" Mode="OneWay" Source="{StaticResource ThemeMgr}"/>
    </UserControl.Background>

    <UserControl.Foreground>
        <Binding Path="DataContext.ThemeForeground" Mode="OneWay" Source="{StaticResource ThemeMgr}"/>
    </UserControl.Foreground>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Column="0"
            Grid.Row="0"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Title:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Title}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="1"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Description:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="1"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Description}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="2"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Company:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="2"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Company}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="3"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Product:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="3"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Product}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="4"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Copyright:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="4"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Copyright}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="5"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Trademark:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="5"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Trademark}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="6"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Version:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="6"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Version}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="7"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="FileVersion:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="7"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding FileVersion}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="8"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Guid:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="8"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Guid}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="9"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Language:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="9"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Language}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="10"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Name:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="10"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Name}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="11"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="Namespace:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="11"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding Namespace}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="12"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="TargetFramework:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="12"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding TargetFramework}"/>

        <TextBlock
            Grid.Column="0"
            Grid.Row="13"
            Style="{StaticResource HeaderTextBlockStyle}"
            Text="OutputType:"/>

        <TextBlock
            Grid.Column="1"
            Grid.Row="13"
            Style="{StaticResource ValueTextBlockStyle}"
            Text="{Binding OutputType}"/>
    </Grid>
</UserControl>
